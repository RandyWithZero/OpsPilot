# Shared local development defaults. Copy to .env for local-only overrides.
NODE_ENV=development
OPSPILOT_WEB_PORT=5173
OPSPILOT_FOUNDATION_PORT=8080

# Local service dependencies used by the root docker-compose.yml.
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
REDIS_URL=redis://localhost:6379/0
MAILPIT_SMTP_URL=smtp://localhost:1025

# Existing foundation-service local development auth.
OPSPILOT_AUTH_DEV_ISSUER=1
OPSPILOT_AUTH_DEV_PASSWORD=local-dev-password
OPSPILOT_AUTH_TOKEN_SECRET=local-dev-secret
