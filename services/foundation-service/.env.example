OPSPILOT_FOUNDATION_PORT=8080
OPSPILOT_AUTH_DEV_ISSUER=1
OPSPILOT_AUTH_DEV_PASSWORD=local-dev-password
OPSPILOT_AUTH_TOKEN_SECRET=local-dev-secret

# Leave empty for in-memory local development.
OPSPILOT_FOUNDATION_MYSQL_DSN=

# Optional object-storage adapter for existing compose demos.
OPSPILOT_OBJECT_STORAGE_ADAPTER=local
OPSPILOT_S3_ENDPOINT_URL=
OPSPILOT_S3_BUCKET=
